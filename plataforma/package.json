{
  "name": "profe-pina-aula",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config apps/presenter/vite.config.ts --host 127.0.0.1",
    "build": "npm run content:check && vite build --config apps/presenter/vite.config.ts",
    "preview": "vite preview --config apps/presenter/vite.config.ts --host 127.0.0.1",
    "content:check": "tsx scripts/content-check.ts",
    "lesson:new": "tsx scripts/new-lesson.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "line-endings:check": "tsx scripts/line-endings.ts",
    "line-endings:fix": "tsx scripts/line-endings.ts --write",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:check": "tsx scripts/check-dist.ts",
    "publish:pdf": "tsx scripts/publish-pdf.ts",
    "preexport:pdf": "tsx scripts/build-pdf.ts",
    "export:pdf": "tsx scripts/export-pdf.ts"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "katex": "0.16.38",
    "lucide-react": "0.468.0",
    "motion": "12.23.24",
    "zod": "3.24.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/katex": "0.16.7",
    "@mdx-js/rollup": "3.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@types/mdx": "2.0.13",
    "remark-frontmatter": "5.0.0",
    "remark-mdx-frontmatter": "5.2.0",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "tsx": "4.23.13",
    "vitest": "5.0.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "26.1.0",
    "@playwright/test": "1.58.2",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.7.4"
  },
  "overrides": {
    "toml": "4.2.0"
  }
}
